[Unit]
Description=Veaver NetworkManager extension and local dashboard
Documentation=https://networkmanager.dev/docs/
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/veaver serve --config /etc/veaver/config.json --state-dir /var/lib/veaver
ExecStopPost=/usr/local/bin/veaver cleanup --state-dir /var/lib/veaver
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
StateDirectory=veaver
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ProtectSystem=strict
ReadWritePaths=/etc/veaver /var/lib/veaver /proc/sys/net/ipv4/conf
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
